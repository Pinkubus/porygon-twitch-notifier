# Copy this file to .env (same folder) and fill in the real values.
# .env is gitignored — never commit your actual token.
#
# Same values as the repo's DISCORD_BOT_TOKEN secret and
# DISCORD_REACTION_CHANNEL_ID/DISCORD_GUILD_ID variables — keep them
# identical so local tools always act as the same bot/guild the production
# loop uses. DISCORD_GUILD_ID is only needed for quotes_watch_local.py.
DISCORD_BOT_TOKEN=REDACTED
DISCORD_REACTION_CHANNEL_ID=
DISCORD_GUILD_ID=

# Anthropic API key, for Porygon Z's AI-judged "six when I get there" callback.
ANTHROPIC_API_KEY=

# Optional: a separate Discord bot token for Porygon Z, so its replies show
# up under its own name/icon instead of the main Porygon bot's. Create a
# second application in the Discord Developer Portal, add a bot to it, invite
# it to the server (View Channels + Send Messages + Read Message History),
# and set its username/avatar there. Falls back to DISCORD_BOT_TOKEN if unset.
DISCORD_Z_BOT_TOKEN=

# Discord user id of "father" — Z addresses its creator differently.
Z_FATHER_USER_ID=

# Comma-separated substrings of channel names where people vent. Z only jokes
# there if the surrounding messages are clearly lighthearted.
Z_DELICATE_CHANNELS=mental-krillness,love-and-depression

# Unprompted replies must self-score at least this out of 10 to get posted.
Z_AUTO_SCORE_THRESHOLD=7.5
# Minimum seconds between unprompted replies in the same channel.
Z_AUTO_COOLDOWN_SECONDS=3600
# Replies before the clingy running bit reaches full frequency.
Z_CLINGY_RAMP=150
# Hours between rebuilds of Z's read on each member.
Z_PROFILE_SCAN_HOURS=24

# Per-task models. Gating runs on every message so it stays cheap; composing
# and scoring decide whether Z is funny, so spend more there.
Z_MODEL_GATE=claude-haiku-4-5-20251001
Z_MODEL_COMPOSE=claude-opus-5
Z_MODEL_SCORE=claude-opus-5
Z_MODEL_PROFILE=claude-sonnet-5
