# Copy this file to .env (same folder) and fill in the real values.
# .env is gitignored — never commit your actual token.
#
# Same values as the repo's DISCORD_BOT_TOKEN secret and
# DISCORD_REACTION_CHANNEL_ID/DISCORD_GUILD_ID variables — keep them
# identical so local tools always act as the same bot/guild the production
# loop uses. DISCORD_GUILD_ID is only needed for quotes_watch_local.py.
DISCORD_BOT_TOKEN=
DISCORD_REACTION_CHANNEL_ID=
DISCORD_GUILD_ID=

# Anthropic API key, for Porygon Z's AI-judged "six when I get there" callback.
ANTHROPIC_API_KEY=

# Model that titles `!feature` suggestions for the control panel — five words
# or less, so the cheapest one is plenty.
FEATURE_TITLE_MODEL=claude-haiku-4-5-20251001

# Optional: a separate Discord bot token for Porygon Z, so its replies show
# up under its own name/icon instead of the main Porygon bot's. Create a
# second application in the Discord Developer Portal, add a bot to it, invite
# it to the server (View Channels + Send Messages + Read Message History),
# and set its username/avatar there. Falls back to DISCORD_BOT_TOKEN if unset.
DISCORD_Z_BOT_TOKEN=

# Discord user id of "father" — every Porygon feature that addresses or refers
# to him uses the names Z has coined for him (porygon_names.json), not a
# hardcoded "father". NAME_EXTRACT_MODEL pulls a new name out of a posted
# reply; it only runs on a line that names him some way not already on the list.
Z_FATHER_USER_ID=
NAME_EXTRACT_MODEL=claude-haiku-4-5-20251001

# Comma-separated substrings of channel names where people vent. Z only jokes
# there if the surrounding messages are clearly lighthearted.
Z_DELICATE_CHANNELS=mental-krillness,love-and-depression

# Unprompted replies must self-score at least this (1-7 scale) to get posted.
Z_AUTO_SCORE_THRESHOLD=4.5

# An explicit !z (or a direct summon: @-mention, reply to Z, or one of its
# nicknames — see Z_NICKNAME_PATTERN) always answers, so it keeps drafting
# fresh attempts, with no cap, until one clears this score. Only gives up if
# this many responses in a row come back empty (real API trouble).
Z_COMMAND_MIN_SCORE=4.5
Z_COMMAND_MAX_ATTEMPTS=12

# Regex for nicknames that count as calling Z out by name (case-insensitive),
# on top of an actual Discord @-mention or a reply to one of Z's messages.
Z_NICKNAME_PATTERN=porygon[\s\-_]?z\b
# Candidate lines drafted per attempt before Z picks its best.
Z_DRAFT_COUNT=5
# Hard ceiling on reply length, in words.
Z_MAX_WORDS=14
# Minimum seconds between unprompted replies in the same channel.
Z_AUTO_COOLDOWN_SECONDS=3600
# Replies before the clingy running bit reaches full frequency.
Z_CLINGY_RAMP=150
# Hours between rebuilds of Z's read on each member.
Z_PROFILE_SCAN_HOURS=24

# Per-task models. Gating runs on every message so it stays cheap; composing
# and scoring decide whether Z is funny, so spend more there (Sonnet, not
# Opus, is the default — 5x cheaper and plenty capable for this).
Z_MODEL_GATE=claude-haiku-4-5-20251001
Z_MODEL_COMPOSE=claude-sonnet-5
Z_MODEL_SCORE=claude-sonnet-5
Z_MODEL_PROFILE=claude-sonnet-5

# Comma-separated Discord user ids whose :jugglez: reaction on a message
# summons Z like a bare !z reply to it. Defaults to Z_FATHER_USER_ID.
Z_REACTION_SUMMONERS=

# Social media auto-poster (!register): anyone can tell Porygon which
# Twitter/Instagram/YouTube accounts to watch, and it posts here when one of
# them goes up with something new. `!register` works in any channel Porygon
# can read; SOCIAL_POST_CHANNEL_ID is just where the results land. Only
# checked from quotes_watch_local.py (a real machine's IP) — Instagram/
# Twitter scraping gets blocked fast from GitHub Actions' datacenter IPs.
SOCIAL_POST_CHANNEL_ID=
# How often (minutes) each registered account is actually re-checked. This
# is independent of the 10s message-scan cadence — don't set it too low,
# Instagram/Twitter rate-limit or block aggressively.
SOCIAL_POLL_MINUTES=15
# Optional: a Nitter mirror (e.g. https://nitter.example.com) for Twitter/X
# support. X no longer allows anonymous scraping at all, so this is the only
# way to get Twitter checks working, and most public Nitter instances are
# unreliable or dead — self-hosting is the only durable option. Leave blank
# to skip Twitter/X checks entirely (YouTube/Instagram still work).
SOCIAL_NITTER_BASE=

# Optional: Instagram now 401s its own anonymous "public profile" endpoint
# for most accounts, so plain unauthenticated checks may just fail. Setting
# this to the `sessionid` cookie value from YOUR OWN browser while logged
# into instagram.com (never a bot account or developer key) makes checks
# meaningfully more reliable. Treat it exactly like a password — never
# commit it, and anyone who gets it can act as your Instagram account.
SOCIAL_IG_SESSIONID=

# Optional: a second Discord server. quotes.py and porygon_z.py both loop
# over DISCORD_GUILD_ID + EXTRA_DISCORD_GUILD_ID (via
# discord_roles.configured_guild_ids()), so !register/!post/!poll/the six
# bit/etc. all work in either server — the bot(s) just need to actually be
# members of it (invite both the main bot and the separate Porygon Z bot,
# DISCORD_Z_BOT_TOKEN's account, with whatever permissions each needs there).
EXTRA_DISCORD_GUILD_ID=
# Optional: a webhook for that second server, if you also want Z's replies
# and Twitch live notifications mirrored to one specific channel there (in
# addition to Z actually posting/reacting live via bot token above). The
# Twitch-notifier side runs in GitHub Actions (loop.py), not here, so it also
# needs the same value set as the EXTRA_DISCORD_WEBHOOK_URL repo secret
# (`gh secret set EXTRA_DISCORD_WEBHOOK_URL`).
EXTRA_DISCORD_WEBHOOK_URL=

# `!post <platform>` (social_backup.py): a manual backup for when the
# auto-poller above hasn't picked up someone's new post yet. How long an
# unanswered "which platform did you mean?" disambiguation poll waits before
# being dropped, in seconds.
SOCIAL_POST_POLL_TTL=3600
